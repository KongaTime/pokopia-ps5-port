# Copy to ps5/local.env (not committed) and set the paths of this machine. ps5/game/build.sh, ps5/game/lift.sh,
# ps5/tools/fetch-deps.sh and ps5/setup.sh read it; a variable already set in the environment wins.

# The PS5 payload SDK (prospero-clang, toolchain/prospero.cmake): https://github.com/ps5-payload-dev/sdk
PS5_SDK=$HOME/ps5-sdk
# PS5_Vulkan (ps5-native-tool, runtime/libc.prx, the RADV archive): https://github.com/mihawk-99/PS5_Vulkan
PS5_VULKAN_DIR=$HOME/PS5_Vulkan
# libSceAgc.so and libSceAgcDriver.so link stubs (RADV imports AGC; any PS5 homebrew toolchain that links RADV has them,
# e.g. PS5_Vulkan's or hb-launcher's build/stubs, with sceAgcInit, sceAgcSuspendPoint and sceAgcDriverSubmitDcb among them)
PKP_AGC_STUBS=$HOME/pkp-ps5-build/agc-stubs
# The PS5 SDL3: ps5/tools/build-sdl3.sh builds it (SDL 3.4.12 with this port's video driver) into $PKP_BUILD/deps/sdl3
PKP_SDL3_INCLUDE=$HOME/pkp-ps5-build/deps/sdl3/include
PKP_SDL3_LIB=$HOME/pkp-ps5-build/deps/sdl3/lib/libSDL3.a

# Work folder: lifted game, dependencies, build tree (several GB; outside the repository)
PKP_BUILD=$HOME/pkp-ps5-build
# Python with the recompiler's requirements (recomp/requirements.txt)
PKP_PYTHON=python3

# The console's address (FTP on 2121 for uploads)
PS5_HOST=192.168.1.10
